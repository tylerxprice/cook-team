{
  "name": "gas-react-tailwind-template",
  "version": "1.0.0",
  "description": "Google Apps Script with React, Tailwind CSS, TypeScript, and V8 Runtime",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json --noEmit && esbuild src/server/Code.ts --bundle --outfile=dist/Code.js --target=es2022",
    "build": "npm run build:client && npm run build:server && node scripts/copy-manifest.js",
    "push": "clasp push -f",
    "deploy": "npm run build && clasp push -f",
    "pull": "clasp pull",
    "logs": "clasp logs",
    "open": "clasp open",
    "preview": "vite preview",
    "test:e2e": "node scripts/test-e2e.mjs"
  },
  "dependencies": {
    "devcontainer": "^0.3.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@google/clasp": "^2.4.2",
    "@types/google-apps-script": "^1.0.89",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-singlefile": "^2.1.0"
  }
}
